# ==============================================================================
# WEJOINLIFE ENVIRONMENT CONFIGURATION (.env)
# Mirrored from EDA-HEALTH-HUB Docker Container Architecture
# ==============================================================================

# Node Environment (production / development)
NODE_ENV=production

# Backend Service Configuration
PORT=8080
SERVER_PORT=8080

# Frontend Service Configuration
VITE_DEV_PORT=3000

# Frontend API Base URL
# For production via Nginx on the same host/domain: leave blank for relative proxying
# Or specify full domain if serving across domains: https://www.vconnectlive.com
VITE_API_URL=

# Cookie & Domain Configuration
# Set to your domain for shared cross-subdomain SSO (e.g. .vconnectlive.com), or leave empty for local/IP
JWT_COOKIE_DOMAIN=
JWT_COOKIE_NAME=wjl_jwt

# Database Connection
# In Docker production on the host machine: host.docker.internal
# For standalone local machine: 127.0.0.1
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=vconnect_prod_portal
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# Multi-Database Schema Mapping (if using multiple databases)
PORTAL_DB=vconnect_prod_portal
CATALOG_DB=vconnect_prod_catalog
VCONNECT_DB=vconnect

# Optional: Override full JDBC URL directly (if defined, overrides DB_HOST/PORT/NAME)
# SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/vconnect_prod_portal?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Security Keys & Salts
# Generate a cryptographically secure 256-bit hexadecimal string for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
CLIENT_PASS_SALT=38fc4120
